includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - includes
        - templates
        - ph-document-manager.php
        - uninstall.php
    # Plugin constants are define()d at runtime in the main file; phpstan
    # cannot discover them statically, so declare them for analysis only.
    bootstrapFiles:
        - tests/phpstan/constants.php
    # Optional: the CI PHP jobs never create node_modules or build, and
    # phpstan 2.x refuses an excludePaths entry that does not exist.
    excludePaths:
        - vendor (?)
        - node_modules (?)
        - build (?)
        - tests (?)
    ignoreErrors:
        # Build asset files are generated by `npm run build` and loaded behind
        # a file_exists() guard, so their absence at analysis time is expected.
        # Not reported as unmatched: locally build/ usually exists.
        -
            identifier: require.fileNotFound
            message: '#build/.*\.asset\.php" is not a file or it does not exist\.#'
            reportUnmatched: false
