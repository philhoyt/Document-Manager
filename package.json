{
    "name": "ph-document-manager",
    "version": "1.1.0",
    "description": "Document Manager WordPress plugin",
    "private": true,
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "lint:js": "wp-scripts lint-js",
        "lint:css": "wp-scripts lint-style",
        "plugin-zip": "npm run build && composer install --no-dev --optimize-autoloader && wp-scripts plugin-zip",
        "test:unit": "wp-scripts test-unit-js",
        "test:e2e": "wp-scripts test-playwright",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "env:clean": "wp-env clean",
        "test:php": "wp-env run tests-cli --env-cwd wp-content/plugins/Document-Manager -- vendor/bin/phpunit"
    },
    "files": [
        "build/**",
        "includes/**",
        "templates/**",
        "vendor/**",
        "composer.json",
        "readme.txt",
        "ph-document-manager.php",
        "uninstall.php"
    ],
    "devDependencies": {
        "@wordpress/a11y": "^4.54.0",
        "@wordpress/env": "^11.14.0",
        "@wordpress/eslint-plugin": "^25.10.0",
        "@wordpress/scripts": "^34.2.0",
        "@wordpress/stylelint-config": "^24.3.0",
        "globals": "^17.12.0"
    }
}
